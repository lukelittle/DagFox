# Copy to .env (`make up` does this for you). Local development values only.

# --- LLM: offline | anthropic | bedrock | azure_openai -------------------
# "offline" is a deterministic, rule-based stand-in that needs no API key.
DAGFOX_LLM_PROVIDER=offline
DAGFOX_LLM_MODEL=
# anthropic:     ANTHROPIC_API_KEY=...          DAGFOX_LLM_MODEL=claude-sonnet-5-5
# bedrock:       AWS_REGION=... (+ AWS creds)   DAGFOX_LLM_MODEL=us.anthropic.claude-sonnet-5-5-v1:0
# azure_openai:  AZURE_OPENAI_ENDPOINT=...  AZURE_OPENAI_API_KEY=...  OPENAI_API_VERSION=...
#                DAGFOX_LLM_MODEL=<deployment name>
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=

# --- Notifications: log | slack | teams ------------------------------------
DAGFOX_NOTIFY_CHANNEL=log
DAGFOX_SLACK_WEBHOOK_URL=
DAGFOX_TEAMS_WEBHOOK_URL=

# --- Local credentials (dev only) -------------------------------------------
DAGFOX_DB_PASSWORD=dagfox
DAGFOX_UI_PASSWORD=dagfox
AIRFLOW_UID=50000
